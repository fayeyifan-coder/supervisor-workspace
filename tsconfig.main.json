{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "rootDir": "src",
    "outDir": "build",
    "noEmitOnError": true
  },
  "include": [
    "src/main.ts",
    "src/database.ts",
    "src/operations.ts",
    "src/production-admission.ts",
    "src/preload.ts",
    "src/contracts.ts"
  ]
}
