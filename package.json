{
  "name": "supervisor-workspace-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Windows workspace for student learning records",
  "author": "Supervisor Workspace",
  "main": "build/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.main.json && vite build --base ./",
    "test": "tsc -p tsconfig.main.json && node --test test/*.test.cjs",
    "pack:win:dir": "electron-builder --win --x64 --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
